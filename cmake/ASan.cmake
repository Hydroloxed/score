option( SCORE_ENABLE_ASAN "Enable AddressSanitizer and UBSan for all targets." OFF )

if( SCORE_ENABLE_ASAN )
    include( CheckCXXCompilerFlag )
    check_cxx_compiler_flag( "-fsanitize=undefined" HAS_FSANITIZE_UNDEFINED )
    if( HAS_FSANITIZE_UNDEFINED )
        add_compile_options( -fsanitize=undefined -fsanitize=integer )
        add_link_options( -fsanitize=undefined -fsanitize=integer )
    endif()
endif()
